# Test of -filter flag.

 deadcode -filter=other.net example.com

 want `other.net`
 want `Dead`
!want `Live`

!want `example.com`
!want `unreferenced`

-- go.mod --
module example.com
go 1.18

require other.net v0.0.0

replace other.net => ./other.net

-- main.go --
package main

import "other.net"

func main() {
	other.Live()
}

func unreferenced() {}

-- other.net/go.mod --
module other.net
go 1.18

-- other.net/other.go --
package other

func Live() {}
func Dead() {}
